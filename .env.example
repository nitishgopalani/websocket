# Copy to .env and paste your API keys (never commit .env)
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
TTS_PROVIDER=sarvam
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=amit
SARVAM_TTS_LANGUAGE=hi-IN

# Sarvam TTS WebSocket streaming (W4)
# SARVAM_TTS_STREAMING=true       # default true; set false to force REST-only
# SARVAM_TTS_PACE=1.0             # default pace (0.5-2.0 for v3); leave empty for Sarvam default
# SARVAM_TTS_WS_URL=              # override WebSocket endpoint (default: wss://api.sarvam.ai/text-to-speech/ws)
